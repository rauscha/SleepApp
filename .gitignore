# Vite leaves these on Windows when cross-mount perms prevent cleanup
vite.config.ts.timestamp-*.mjs
# Per-machine Claude Code settings (analogue of .env.local — never share)
.claude/settings.local.json
# Claude Code worktree state (local-only, sometimes leaves residue)
.claude/worktrees/
# Raw audio source files — pre-processing inputs, kept locally only.
# The processed outputs go in public/audio/ and DO get committed.
raw-sounds/

# Raw photo source files — pre-processing inputs, kept locally only.
# The processed outputs go in public/scenes/photos/ and DO get committed.
ACR-photos/

# Local secrets — API keys pasted into untracked txt files during dev.
elevenlabs.txt
anthropic.txt
*.secret.txt

# mkcert-generated dev certs — per-machine, regenerate via tools/gen-dev-cert
certs/

# Personal working notebooks — kept local, not part of the public repo.
NEXT_STEPS.md
USER_TODO.md

# loudnorm backups created by tools/normalize-existing-content.sh
*.pre-loudnorm.mp3

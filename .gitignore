node_modules
dist
dist-ssr
*.local
.DS_Store
.env
.env.*
!.env.example
.vite
.cache
*.log
# Vite leaves these on Windows when cross-mount perms prevent cleanup
vite.config.ts.timestamp-*.mjs
# Per-machine Claude Code settings (analogue of .env.local — never share)
.claude/settings.local.json
# Claude Code worktree state (local-only, sometimes leaves residue)
.claude/worktrees/
# Raw audio source files — pre-processing inputs, kept locally only.
# The processed outputs go in public/audio/ and DO get committed.
raw-sounds/

# Raw photo source files — pre-processing inputs, kept locally only.
# The processed outputs go in public/scenes/photos/ and DO get committed.
ACR-photos/

# Local secrets — API keys pasted into untracked txt files during dev.
elevenlabs.txt
anthropic.txt
*.secret.txt
# Scratch docs that may hold pasted keys (Google Drive "Untitled document"
# exports, etc.) — never commit these.
Untitled*.txt
untitled*.txt
# Google Drive pointer files (.gdoc/.gsheet/etc.) — these reference cloud
# docs, several of which hold API keys. Local-only, never publish.
*.gdoc

# mkcert-generated dev certs — per-machine, regenerate via tools/gen-dev-cert
certs/
# TLS certs and private keys (mkcert output at repo root, etc.) — a .pem
# key is a secret; must never be committed.
*.pem

# Personal working notebooks — kept local, not part of the public repo.
NEXT_STEPS.md
USER_TODO.md

# loudnorm backups created by tools/normalize-existing-content.sh
*.pre-loudnorm.mp3

# Diagnostic clip-scrubber page (audio QA tool, served by dev server only —
# must never ship to the public build). Throwaway; regenerate as needed.
public/scrub/

# Local mkcert helper scripts — per-machine convenience scripts for
# generating dev TLS certs. Not project code; regenerate as needed.
go.js
go.vbs
go.bat
mkcert-go.bat
run-mkcert.bat
setup-mkcert.bat

# Local reviews/ directory — output from deep-review sessions, personal
# audit notes, spectrogram dumps, etc. Not shipped code.
reviews/

# Python bytecode cache — tools/ is a script dir, not a package
__pycache__/
*.pyc
